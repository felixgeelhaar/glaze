{
  "name": "glaze-design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=22.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{js,ts,tsx,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,jsx,json,md,css}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "release:dry": "pnpm build && changeset publish --dry-run",
    "setup:npm": "node scripts/setup-npm-publishing.js"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "9.33.0",
    "@playwright/test": "1.55.1",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "playwright": "^1.55.1",
    "prettier": "^3.8.3",
    "stylelint": "^16.23.1",
    "stylelint-config-standard": "^39.0.0",
    "turbo": "^2.9.14",
    "typescript": "^5.9"
  },
  "dependencies": {
    "@babel/core": "^7.29.6",
    "axios": "^1.8.2",
    "basic-ftp": "^5.3.1",
    "brace-expansion": "^1.1.16",
    "diff": "^5.2.2",
    "esbuild": "^0.25.0",
    "fast-uri": "^3.1.2",
    "follow-redirects": "^1.16.0",
    "form-data": "^4.0.6",
    "glob": "^10.5.0",
    "js-yaml": "^4.1.1",
    "koa": "^2.16.3",
    "lodash": "^4.17.23",
    "nanoid": "^3.3.17",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.18",
    "qs": "^6.14.2",
    "rollup": "^4.59.0",
    "style-dictionary": "^5.4.4",
    "tar": "^7.5.16",
    "tar-fs": "^3.1.1",
    "tmp": "^0.2.6",
    "tslib": "^2.8.1",
    "vite": "^7.3.5",
    "ws": "^7.5.11",
    "yaml": "^2.8.3"
  }
}
