      "fast-uri@<3.1.6": "^3.1.6",
      "follow-redirects@<1.16.0": "^1.16.0",
      "form-data@<4.0.6": "^4.0.6",
      "glob@<10.5.0": "^10.5.0",
      "glob@<14.0.2": "^14.0.2",
      "happy-dom@<20.14.6": "^20.14.6",
      "happy-dom@<21.0.4": "^21.0.4",
      "ip-address@<10.7.4": "^10.7.4",
      "js-yaml@<3.15.2": "^3.15.2",
