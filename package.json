{
  "name": "glaze-design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=22.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{js,ts,tsx,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,jsx,json,md,css}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "release:dry": "pnpm build && changeset publish --dry-run",
    "setup:npm": "node scripts/setup-npm-publishing.js"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "9.33.0",
    "@playwright/test": "1.55.1",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "playwright": "^1.55.1",
    "prettier": "^3.8.3",
    "stylelint": "^16.23.1",
    "stylelint-config-standard": "^39.0.0",
    "turbo": "^2.9.14",
    "typescript": "^5.9"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<7.29.6": "^7.29.6",
      "@storybook/core@<8.6.19": "8.6.19",
      "@vitest/mocker@<4.1.11": "^4.1.11",
      "@vue/server-renderer@<3.5.42": "^3.5.42",
      "axios@<1.18.0": "^1.18.0",
      "basic-ftp@<5.3.1": "^5.3.1",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=2.0.0 <2.1.4": "^2.1.4",
      "browserslist@<4.28.7": "^4.28.7",
      "colord@<2.9.4": "^2.9.4",
      "diff@<5.2.2": "^5.2.2",
